# Inlined into the app at build time — nothing secret belongs here.
# Web and iOS simulator reach the API on localhost; the Android emulator
# reaches the host machine at 10.0.2.2; a real phone needs the PC's LAN IP.
EXPO_PUBLIC_API_URL_DEV=http://localhost:5020/api/v1
EXPO_PUBLIC_API_URL=

# Help & Support on the phone (blank hides the button)
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_WEBSITE_URL=https://oscall28octfront.vercel.app
