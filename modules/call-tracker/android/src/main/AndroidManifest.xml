<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- What the call tracker reads. Each is asked for at setup with a line on why. -->
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- caller names on the log, and the number behind a WhatsApp contact's name -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <!-- "call back" from the log, and the test call that proves a SIM's number -->
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <!-- opening the after-call sheet the moment a call ends -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- asks to be left out of battery saving; the rep still decides -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- follow-up reminders are set again after a restart -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- the background-sync service and its ongoing notification -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <!-- Call ended → after-call sheet. Only the system (which holds
         READ_PHONE_STATE) can send it, so another app can't fake a call. -->
    <receiver
      android:name=".CallStateReceiver"
      android:exported="true"
      android:permission="android.permission.READ_PHONE_STATE">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>

    <!-- WhatsApp call capture. Android binds it only after the rep switches on
         notification access for this app, and only the system can bind it. -->
    <service
      android:name=".WhatsAppCallListener"
      android:label="WhatsApp call logging"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Keeps calls syncing while the app is closed. Ours only, so not exported. -->
    <service
      android:name=".SyncService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- Lead follow-up reminders: our own alarm, so not exported. -->
    <receiver android:name=".FollowupAlarmReceiver" android:exported="false" />
    <receiver android:name=".FollowupBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
