{
  "name": "callos-front",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "npx expo lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && npm run lint && npm test",
    "test": "tsx --test tests/*.test.ts",
    "vendor:twilio": "node -e \"require('fs').copyFileSync('node_modules/@twilio/voice-sdk/dist/twilio.min.js','public/vendor/twilio-voice.min.js')\"",
    "postinstall": "npm run vendor:twilio"
  },
  "dependencies": {
